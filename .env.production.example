# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ─── App ──────────────────────────────────────────────────────────────────────
# Замените на реальный домен сайта (без слеша в конце)
SITE_NAME=Лента стальная — каталог металлопроката
SITE_URL=https://lenta-stalnaja.ru
# Абсолютный путь до git-репозитория на сервере (для кнопки /admin/deploy)
DEPLOY_REPO_DIR=/home/i/infogkmeta/lenta-stalnaja

# ─── MySQL (SpaceWeb) ─────────────────────────────────────────────────────────
# Данные берутся из панели SpaceWeb → Базы данных → MySQL
# Хост обычно: localhost (если приложение на том же сервере)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=infogkmeta_XXXX
MYSQL_PASSWORD=YOUR_MYSQL_PASSWORD
MYSQL_DATABASE=infogkmeta_XXXX

# ─── Admin ────────────────────────────────────────────────────────────────────
# Измените перед первым запуском!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ─── Price range (для авто-генерации цен при импорте без цены) ────────────────
PRICE_RANDOM_MIN=1000
PRICE_RANDOM_MAX=10000

# ─── Session secret ───────────────────────────────────────────────────────────
# Сгенерируйте случайную строку: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=CHANGE_ME_RANDOM_HEX_STRING

# ─── SMTP (уведомления о заявках) ─────────────────────────────────────────────
# Ящик на хостинге, с которого шлём письма. Данные — панель SpaceWeb → Почта.
SMTP_HOST=smtp.spaceweb.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@lenta-stalnaja.ru
SMTP_PASSWORD=CHANGE_ME_MAILBOX_PASSWORD
# From: обычно совпадает с SMTP_USER (иначе письмо уйдёт в спам)
SMTP_FROM=info@lenta-stalnaja.ru
# Куда пересылать заявки — можно несколько через запятую (уйдёт на все сразу)
LEAD_NOTIFY_TO=corp-metalinvest01265@yandex.ru,ev18011@yandex.ru
