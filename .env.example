# Server
PORT=3000
NODE_ENV=development

# App
SITE_NAME=Каталог металлопроката
SITE_URL=http://localhost:3000

# SQLite (path relative to project root, used for admin/leads/categories)
DB_PATH=./data/app.db

# MySQL (main product catalog)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=metal_catalog

# Admin (created on seed if not exists)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Random price range for import when price is empty (rub)
PRICE_RANDOM_MIN=1000
PRICE_RANDOM_MAX=10000

# Session secret (change in production!)
SESSION_SECRET=change-me-in-production
